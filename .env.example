# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional settings
JARVIS_USER_NAME=sir              # how Jarvis addresses you
JARVIS_MODEL=claude-opus-5-5      # Claude model used as the brain
JARVIS_EFFORT=low                 # low | medium | high  (low = snappiest replies)
JARVIS_WHISPER_MODEL=base.en      # tiny.en / base.en / small.en / medium.en
JARVIS_WAKE_THRESHOLD=0.5         # 0-1, raise if Jarvis wakes up by accident
JARVIS_TTS_VOICE=                 # optional voice name (e.g. "Daniel" on macOS)
JARVIS_TTS_RATE=185               # speaking speed (words per minute)
JARVIS_UNSAFE_NO_CONFIRM=0        # 1 = run shell commands / file writes without asking
