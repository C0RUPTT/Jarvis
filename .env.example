# ---- Who you are ----
JARVIS_USER_NAME=sir                 # how Jarvis addresses you

# ---- Brain ----
# claude-code (default): Claude Code on this laptop, using your Claude Pro/Max login - no API bill.
# api: the Claude API directly (needs ANTHROPIC_API_KEY, pay per use).
JARVIS_BRAIN=claude-code
JARVIS_CC_MODEL=sonnet               # sonnet (fast + smart) | opus (smartest) | haiku (fastest)
JARVIS_CC_PERMISSION_MODE=auto       # auto | acceptEdits | bypassPermissions (see docs/PHONE_SETUP.md)
JARVIS_EFFORT=low                    # low = snappiest replies; medium/high think harder
# JARVIS_WORKDIR=~                   # folder Claude Code works in (default: your home folder)
# ANTHROPIC_API_KEY=sk-ant-...       # only for JARVIS_BRAIN=api
# JARVIS_MODEL=claude-opus-5-5       # only for JARVIS_BRAIN=api

# ---- Phone ----
JARVIS_PORT=8765                     # the MCP tool bridge uses this port + 1
# free push notifications: pick a hard-to-guess name
JARVIS_NTFY_TOPIC=
JARVIS_ONLINE_VOICE=en-GB-RyanNeural # free neural voice; leave empty to use the phone's voice
# JARVIS_TOKEN=                      # secret for the phone (auto-generated in ~/.jarvis/token)

# ---- Speech ----
JARVIS_WHISPER_MODEL=base.en         # tiny.en (fastest) / base.en / small.en (most accurate)
JARVIS_WAKE_THRESHOLD=0.5            # laptop wake word sensitivity (0-1)
# laptop speaker voice name (optional)
JARVIS_TTS_VOICE=
JARVIS_TTS_RATE=185
JARVIS_UNSAFE_NO_CONFIRM=0           # api brain only: 1 = run commands without asking
